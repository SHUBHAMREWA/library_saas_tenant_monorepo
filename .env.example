# =================================================================
# Library Management SaaS - Unified Monorepo Environment Variables
# =================================================================

# Global Environment
NODE_ENV=development

# -----------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=library_saas_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/library_saas_db?schema=public"

# -----------------------------------------------------------------
# 2. Redis Cache & Job Queue
# -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------
# 3. Backend API Service (apps/api)
# -----------------------------------------------------------------
API_PORT=4000
JWT_SECRET="super-secure-jwt-access-secret-minimum-32-chars-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secure-jwt-refresh-secret-minimum-32-chars-2026"
JWT_REFRESH_EXPIRES_IN="7d"
OTP_SALT="salted-hmac-secret-for-phone-and-email-otps"
CORS_ORIGIN="http://localhost:3000,https://app.librarysaas.com"
ADMIN_EMAIL="admin@libraryhub.com"
ADMIN_NAME="Platform Super Admin"
ADMIN_PHONE="+919876543210"

